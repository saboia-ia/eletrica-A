# ==========================================================
# Variáveis de ambiente - MODELO (não commitar o .env real)
# ==========================================================
#
# O site atual é 100% estático e NÃO utiliza nenhuma chave de
# API ou segredo em tempo de execução. Este arquivo existe para
# documentar quais variáveis poderão ser necessárias caso uma
# integração (analytics, API de Leads, forms backend) seja
# adicionada no futuro.
#
# Copie para `.env` (que já está ignorado pelo .gitignore):
#   cp .env.example .env
#
# Nunca versionar o arquivo `.env` preenchido.

# Identificador público do Google Analytics 4 (opcional).
# Não é uma chave secreta, mas fica fora do HTML por padrão.
GA_MEASUREMENT_ID=

# Chave pública do Google Maps / Places para exibir o mapa da empresa.
GOOGLE_MAPS_API_KEY=

# Token do backend que recebe o formulário de contato (opcional).
# Ex.: https://api.exemplo.com/leads
FORMS_API_URL=
FORMS_API_TOKEN=

# Número do WhatsApp usado no envio do formulário (formato E.164).
WHATSAPP_NUMBER=5511988840073
